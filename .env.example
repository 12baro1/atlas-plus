# Official Bybit regional API for Türkiye; use https://api.bybit.com where permitted.
CHRONOS_BYBIT_BASE_URL=https://api.bybit.tr
CHRONOS_DB=chronos.sqlite3
CHRONOS_SCAN_LIMIT=20
CHRONOS_INTERVAL_SECONDS=900
CHRONOS_WORKERS=3
CHRONOS_TIMEOUT_SECONDS=9
CHRONOS_MIN_TURNOVER=20000000
# Optional: alerts only, bot never accepts/orders trades.
CHRONOS_TELEGRAM_TOKEN=
CHRONOS_TELEGRAM_CHAT_ID=
